---
interface Props {
  title: string;
  id?: string;
  /** Promote to h1 when this section is the page's topic. */
  as?: 'h1' | 'h2';
}

const { title, id, as: Tag = 'h2' } = Astro.props;
// Generate a URL-safe ID from title if not provided
const sectionId = id || title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class="section-header mb-4">
  <Tag id={sectionId} class="font-display text-sm uppercase tracking-wide text-accent">
    {title}
  </Tag>
  <div class="mt-1 border-t border-accent/30"></div>
</div>
