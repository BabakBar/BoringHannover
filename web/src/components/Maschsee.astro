---
const wave = (y: number, amp: number) =>
  `M0 ${y} ` +
  Array.from({ length: 24 }, (_, i) => `q50 ${i % 2 ? amp : -amp} 100 0`).join(' ') +
  ' V120 H0 Z';
---

<section class="lake reveal reveal-5" aria-label="The Maschsee">
  <p class="lake-label">Maschsee · 78 ha · dug 1934–36</p>
  <svg class="water back" viewBox="0 0 2400 120" preserveAspectRatio="none" aria-hidden="true">
    <path d={wave(62, 6)} />
  </svg>
  <button type="button" class="boat" data-toast="The Maschsee is man-made: dug in 1934–36, 78 hectares, a short walk from the Neues Rathaus." aria-label="A sailing boat on the Maschsee">
    <svg width="40" height="46" viewBox="0 0 40 46" aria-hidden="true">
      <path d="M19 3 V33 H5 Z" fill="#fafaf9" stroke="#1c1917" stroke-width="1" />
      <path d="M21 9 V33 H33 Z" fill="var(--accent)" />
      <path d="M2 34 H38 L33 41 H7 Z" fill="var(--text-secondary)" />
    </svg>
  </button>
  <button type="button" class="stadium" data-matchday aria-label="The stadium by the Maschsee, home of Hannover 96">
    <svg width="104" height="61" viewBox="0 0 78 46" aria-hidden="true">
      <g class="lights" fill="#fde68a">
        <rect x="4" y="2" width="8" height="4" rx="1" />
        <rect x="66" y="2" width="8" height="4" rx="1" />
      </g>
      <path d="M8 6 V30 M70 6 V30" stroke="var(--text-secondary)" stroke-width="1.5" />
      <path d="M3 34 Q39 18 75 34 V42 H3 Z" fill="var(--text-muted)" />
      <path d="M5 31 Q39 15 73 31 L73 34 Q39 18 5 34 Z" fill="#1fa83a" />
      <text x="39" y="39.5" text-anchor="middle" fill="#111" stroke="#fafaf9" stroke-width="1.6" paint-order="stroke" font-size="8.5" font-weight="900" font-style="italic" font-family="monospace">96</text>
    </svg>
  </button>
  <div class="swim">
    <button type="button" class="pelican" data-toast="No pelicans on the Maschsee. But Pelikan has made ink and fountain pens in Hannover since 1838." aria-label="A pelican on the Maschsee">
      <svg width="58" height="58" viewBox="0 0 40 40" aria-hidden="true">
        <g fill="#fafaf9" stroke="#1c1917" stroke-width="0.6">
          <ellipse cx="20" cy="27" rx="9" ry="5" />
          <path d="M24 25 Q27 14 25 10 Q24 7 21 8 Q19 9 20 12 Q22 16 19 24 Z" />
          <circle cx="22.5" cy="9.5" r="3" />
        </g>
        <path d="M20 9 L6 13 L8 14 L20 12 Z" fill="#f5a000" stroke="#1c1917" stroke-width="0.4" />
        <path d="M8 14 Q12 19 19 13 Z" fill="#f7c35a" stroke="#1c1917" stroke-width="0.4" />
        <circle cx="22" cy="8.8" r="0.8" fill="#1c1917" />
      </svg>
    </button>
  </div>
  <svg class="water front" viewBox="0 0 2400 120" preserveAspectRatio="none" aria-hidden="true">
    <path d={wave(84, 5)} />
  </svg>
</section>

<style>
  .lake {
    --lake: #8ec2e0;
    --lake-deep: #5f9fc7;
    position: relative;
    height: 120px;
    margin-top: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-secondary);
  }
  :global(.dark) .lake { --lake: #1d3a50; --lake-deep: #16324a; }
  .lake-label {
    position: absolute;
    top: 0.7rem;
    left: 1rem;
    margin: 0;
    font: 400 0.62rem var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .water { pointer-events: none; position: absolute; left: 0; bottom: 0; width: 200%; height: 100%; }
  .water.back path { fill: var(--lake); }
  .water.front path { fill: var(--lake-deep); opacity: 0.9; }
  .water.back { animation: waves 26s linear infinite; }
  .water.front { animation: waves 17s linear infinite reverse; }
  @keyframes waves { to { transform: translateX(-50%); } }

  .stadium { position: absolute; right: 3%; bottom: 46px; }
  .stadium .lights { opacity: 0.6; transition: opacity 0.2s; }
  .stadium:hover .lights, .stadium:focus-visible .lights { opacity: 1; filter: drop-shadow(0 0 4px #fde68a); }
  .boat, .pelican, .stadium { padding: 0; border: 0; background: none; cursor: pointer; }
  .boat:focus-visible, .pelican:focus-visible, .stadium:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .boat {
    position: absolute;
    bottom: 50px;
    left: 8%;
    animation: sail 70s ease-in-out infinite alternate, bob 3.2s ease-in-out infinite alternate;
  }
  .swim {
    position: absolute;
    bottom: 30px;
    left: 70%;
    animation: swim 48s linear infinite;
  }
  .pelican { animation: face 48s step-end infinite, bob 2.4s ease-in-out infinite alternate; }
  .pelican:hover svg { transform: rotate(-8deg); }
  .pelican svg { transition: transform 0.2s; }
  @keyframes sail { to { left: 52%; } }
  @keyframes swim { 0%, 100% { left: 78%; } 50% { left: 58%; } }
  @keyframes face { 0% { transform: scaleX(1); } 50% { transform: scaleX(-1); } }
  @keyframes bob { to { translate: 0 -3px; } }

  @media (prefers-reduced-motion: reduce) {
    .water.back, .water.front, .boat, .swim, .pelican { animation: none; }
  }
</style>
