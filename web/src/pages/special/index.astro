---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ActiveOccasion from '../../components/ActiveOccasion.astro';
import Pictogram from '../../components/Pictogram.astro';
import Footer from '../../components/Footer.astro';
import { loadEventData } from '../../data/loader';
import type { OccasionSummary } from '../../data/types';
import { WEEK_NAMES, indexAdmission } from '../../utils/occasionIndex';
import { appointmentHours, sheetDateLine } from '../../utils/occasionSheet';
import { dayHeading, indexV2, isSeasonLong, spanText } from '../../utils/occasionV2';
import { berlinClock } from '../../utils/occasionStatus';
import { experimentNow } from '../../utils/experimentNow';

const eventData = loadEventData();
const { meta, occasions } = eventData;
const now = experimentNow(Astro.url);
const v2 = indexV2(occasions, now);
const count = v2.season.length + v2.days.reduce((sum, day) => sum + day.entries.length, 0);
const untilFormat = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short' });

function extra(occasion: OccasionSummary) {
  return isSeasonLong(occasion)
    ? `until ${untilFormat.format(new Date(`${occasion.endDate}T00:00:00Z`))}`
    : spanText(occasion);
}

function facts(occasion: OccasionSummary) {
  const dayTrip = occasion.area === 'region' && occasion.place?.municipality
    ? `Day trip · ${occasion.place.municipality}` : null;
  return { venue: occasion.place?.venue ?? occasion.location, admission: indexAdmission(occasion), dayTrip };
}

// Every row is rendered once; the script moves rows between the season list,
// the day sections and this pool on the reader's clock.
const listed = new Set([
  ...v2.season.map(entry => entry.occasion.slug),
  ...v2.days.flatMap(day => day.entries.map(entry => entry.occasion.slug)),
]);
const today = berlinClock(now).date;
const pooled = occasions.filter(occasion =>
  !listed.has(occasion.slug) && occasion.endDate >= today &&
  !v2.check.includes(occasion) && !v2.off.includes(occasion));
---

<Base
  title="City Occasions · boringhannover"
  description="Festivals, Christmas markets and one-off city moments in Hannover for the next 30 days: what is open all season, and what happens on which day."
>
  <Header week={meta.week} year={meta.year} brandAsHeading={false} compact />

  <nav class="mb-2" aria-label="Breadcrumb">
    <a href="/" class="inline-flex min-h-11 items-center font-display text-[11px] uppercase tracking-wide text-text-secondary hover:text-accent">
      ← Weekly digest
    </a>
  </nav>

  <section class="occasion-index" aria-labelledby="city-occasions">
    <SectionHeader id="city-occasions" title="City Occasions" as="h1" />
    <p class="index-summary" data-index-summary>{count} occasions in the next 30 days.</p>

    <div class="week-browser" role="group" aria-labelledby="week-browser-label" hidden>
      <div class="week-browser__header">
        <span id="week-browser-label">Browse by week</span>
        <button class="week-browser__all" type="button" data-index-all aria-pressed="true">All dates</button>
      </div>
      <div class="week-browser__weeks">
        {WEEK_NAMES.map((name) => (
          <button class="week-card" type="button" data-index-week aria-pressed="false">
            <span class="week-card__name">{name}</span>
            <span class="week-card__dates" data-week-dates></span>
          </button>
        ))}
      </div>
      <p class="sr-only" data-index-results role="status"></p>
    </div>

    <section class="season" aria-labelledby="season-title" data-season hidden={v2.season.length === 0}>
      <h2 id="season-title" class="part-head"><span>Open all season</span><span class="part-head__count" data-season-count>{v2.season.length}</span></h2>
      <ol class="season-list" data-season-list>
        {v2.season.map(({ occasion, status, open }) => {
          const { venue, admission, dayTrip } = facts(occasion);
          return (
            <ActiveOccasion slug={occasion.slug}>
              <li class:list={['row', { 'is-open': open }]} data-row={occasion.slug} data-schedule={JSON.stringify({ ...occasion, preview: undefined, description: undefined })}>
                <a class="row__link" href={`/special/${occasion.slug}/`} data-umami-event="occasion-open" data-umami-event-occasion={occasion.slug}>
                  <Pictogram name={occasion.name} step={3} class="row__picto" />
                  <span class="row__when" data-when>{status}</span>
                  <span class="row__body">
                    <span class="row__name" lang="de">{occasion.name}</span>
                    <span class="row__sub"><span lang="de">{venue}</span>{dayTrip && <span class="row__tag">{dayTrip}</span>}{admission && <span>· {admission}</span>}{extra(occasion) && <span>· {extra(occasion)}</span>}</span>
                  </span>
                </a>
              </li>
            </ActiveOccasion>
          );
        })}
      </ol>
    </section>

    <section class="days" aria-labelledby="days-title" data-days hidden={v2.days.length === 0}>
      <h2 id="days-title" class="part-head"><span>By date</span><span class="part-head__count" data-days-count>{v2.days.reduce((sum, day) => sum + day.entries.length, 0)}</span></h2>
      <div data-day-list>
        {v2.days.map(({ date, entries }) => (
          <section class="day" id={`day-${date}`} aria-labelledby={`day-${date}-title`}>
            <h3 class="day__head" id={`day-${date}-title`}><span class="day__date">{dayHeading(date)}</span><span class="day__rel" data-rel></span></h3>
            <ol class="day-list">
              {entries.map(({ occasion, appointment }) => {
                const { venue, admission, dayTrip } = facts(occasion);
                return (
                  <ActiveOccasion slug={occasion.slug}>
                    <li class="row" data-row={occasion.slug} data-schedule={JSON.stringify({ ...occasion, preview: undefined, description: undefined })}>
                      <a class="row__link" href={`/special/${occasion.slug}/`} data-umami-event="occasion-open" data-umami-event-occasion={occasion.slug}>
                        <Pictogram name={occasion.name} step={3} class="row__picto" />
                        <span class="row__when" data-when>{appointmentHours(appointment) ?? ''}</span>
                        <span class="row__body">
                          <span class="row__name" lang="de">{occasion.name}</span>
                          <span class="row__sub"><span lang="de">{venue}</span>{dayTrip && <span class="row__tag">{dayTrip}</span>}{admission && <span>· {admission}</span>}{extra(occasion) && <span>· {extra(occasion)}</span>}</span>
                        </span>
                      </a>
                    </li>
                  </ActiveOccasion>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </section>

    {v2.check.length > 0 && (
      <section class="days" aria-labelledby="check-title">
        <h2 id="check-title" class="part-head part-head--muted"><span>Check dates</span></h2>
        <ol class="season-list">
          {v2.check.map(occasion => (
            <ActiveOccasion slug={occasion.slug}>
              <li class="row"><a class="row__link" href={`/special/${occasion.slug}/`}><Pictogram name={occasion.name} step={3} class="row__picto" /><span class="row__when">{sheetDateLine(occasion)}</span><span class="row__body"><span class="row__name" lang="de">{occasion.name}</span><span class="row__sub" lang="de">{facts(occasion).venue}</span></span></a></li>
            </ActiveOccasion>
          ))}
        </ol>
      </section>
    )}

    <div hidden data-pool>
      {pooled.map(occasion => {
        const { venue, admission, dayTrip } = facts(occasion);
        return (
          <ActiveOccasion slug={occasion.slug}>
            <li class="row" data-row={occasion.slug} data-schedule={JSON.stringify({ ...occasion, preview: undefined, description: undefined })}>
              <a class="row__link" href={`/special/${occasion.slug}/`} data-umami-event="occasion-open" data-umami-event-occasion={occasion.slug}>
                <Pictogram name={occasion.name} step={3} class="row__picto" />
                <span class="row__when" data-when></span>
                <span class="row__body">
                  <span class="row__name" lang="de">{occasion.name}</span>
                  <span class="row__sub"><span lang="de">{venue}</span>{dayTrip && <span class="row__tag">{dayTrip}</span>}{admission && <span>· {admission}</span>}{extra(occasion) && <span>· {extra(occasion)}</span>}</span>
                </span>
              </a>
            </li>
          </ActiveOccasion>
        );
      })}
    </div>

    <div class="index-empty" data-index-empty hidden={count > 0}>
      <p data-index-empty-text>No City Occasions are listed for the next 30 days.</p>
      <div class="index-empty__actions">
        <a href="/" class="index-empty__action">Weekly digest</a>
        <a href="https://www.hannover.de/Veranstaltungskalender/Feste-Festivals" target="_blank" rel="noopener noreferrer" class="index-empty__action">Festival listing on hannover.de<span aria-hidden="true">&nbsp;↗</span></a>
      </div>
    </div>
  </section>

  <Footer updatedAt={meta.updatedAt} />
</Base>

<script>
  import { occasionWeeks } from '../../utils/occasionIndex';
  import { appointmentHours } from '../../utils/occasionSheet';
  import { berlinClock } from '../../utils/occasionStatus';
  import { dayHeading, indexV2, relativeDay } from '../../utils/occasionV2';
  import type { OccasionSummary } from '../../data/types';

  const browser = document.querySelector<HTMLElement>('.week-browser')!;
  const allDates = browser.querySelector<HTMLButtonElement>('[data-index-all]')!;
  const weekButtons = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-index-week]'));
  const weekLabels = weekButtons.map(button => button.querySelector('[data-week-dates]')!);
  const announcement = document.querySelector('[data-index-results]')!;
  const seasonSection = document.querySelector<HTMLElement>('[data-season]')!;
  const seasonList = document.querySelector<HTMLElement>('[data-season-list]')!;
  const daysSection = document.querySelector<HTMLElement>('[data-days]')!;
  const dayList = document.querySelector<HTMLElement>('[data-day-list]')!;
  const pool = document.querySelector<HTMLElement>('[data-pool]')!;
  const summary = document.querySelector('[data-index-summary]')!;
  const empty = document.querySelector<HTMLElement>('[data-index-empty]')!;
  const emptyText = document.querySelector('[data-index-empty-text]')!;

  const elements = new Map<string, HTMLElement>();
  const data: Array<OccasionSummary & { element: HTMLElement }> = [];
  for (const element of document.querySelectorAll<HTMLElement>('[data-row][data-schedule]')) {
    const slug = element.dataset.row!;
    if (elements.has(slug)) continue;
    elements.set(slug, element);
    data.push({ ...JSON.parse(element.dataset.schedule!), element });
  }

  let selectedWeek: number | null = null;
  let signature = '';

  function place(element: HTMLElement, when: string, href: string, open = false) {
    element.querySelector('[data-when]')!.textContent = when;
    element.classList.toggle('is-open', open);
    const link = element.querySelector<HTMLAnchorElement>('.row__link')!;
    if (link.getAttribute('href') !== href) link.setAttribute('href', href);
    return element;
  }

  function refresh() {
    const now = new Date();
    const weeks = occasionWeeks(berlinClock(now).date);
    weekLabels.forEach((label, i) => { label.textContent = weeks[i].dates; });
    const week = selectedWeek === null ? null : weeks[selectedWeek];
    const result = indexV2(data, now, week ? { from: week.startDate, to: week.endDate } : undefined);
    const next = JSON.stringify([selectedWeek, result.season.map(e => [e.occasion.name, e.status]), result.days.map(d => [d.date, relativeDay(d.date, now), d.entries.map(e => e.occasion.name)])]);
    if (next === signature) return;
    signature = next;
    const focused = document.activeElement?.closest<HTMLElement>('[data-row]')?.dataset.row;
    const href = (slug: string, date: string) => week ? `/special/${slug}/?date=${date}` : `/special/${slug}/`;
    pool.append(...elements.values());
    seasonList.replaceChildren(...result.season.map(({ occasion, appointment, status, open }) =>
      place(elements.get(occasion.slug)!, status, href(occasion.slug, appointment.date), open)));
    dayList.replaceChildren(...result.days.map(({ date, entries }) => {
      const section = document.createElement('section');
      section.className = 'day';
      section.id = `day-${date}`;
      const head = document.createElement('h3');
      head.className = 'day__head';
      head.innerHTML = '<span class="day__date"></span><span class="day__rel"></span>';
      head.children[0].textContent = dayHeading(date);
      head.children[1].textContent = relativeDay(date, now);
      const list = document.createElement('ol');
      list.className = 'day-list';
      list.append(...entries.map(({ occasion, appointment }) =>
        place(elements.get(occasion.slug)!, appointmentHours(appointment) ?? '', href(occasion.slug, appointment.date))));
      section.append(head, list);
      return section;
    }));
    const dated = result.days.reduce((sum, day) => sum + day.entries.length, 0);
    seasonSection.hidden = result.season.length === 0;
    daysSection.hidden = dated === 0;
    document.querySelector('[data-season-count]')!.textContent = String(result.season.length);
    document.querySelector('[data-days-count]')!.textContent = String(dated);
    const total = result.season.length + dated;
    summary.textContent = week
      ? `${total} occasions ${week.name.toLowerCase()}, ${week.dates}.`
      : `${total} occasions in the next 30 days.`;
    empty.hidden = total > 0;
    emptyText.textContent = week ? `No upcoming confirmed occasions for ${week.dates}.` : 'No City Occasions are listed for the next 30 days.';
    if (week) announcement.textContent = `${total} occasions · ${week.name}, ${week.dates}.`;
    if (focused) elements.get(focused)?.querySelector<HTMLElement>('.row__link')?.focus({ preventScroll: true });
    if (location.hash && !week) document.querySelector(location.hash)?.scrollIntoView();
  }

  function buttonFor(index: number | null) {
    return index === null ? allDates : weekButtons[index];
  }

  function selectWeek(index: number | null) {
    if (selectedWeek === index) return;
    buttonFor(selectedWeek).setAttribute('aria-pressed', 'false');
    selectedWeek = index;
    buttonFor(selectedWeek).setAttribute('aria-pressed', 'true');
    refresh();
  }

  if (data.length > 0) {
    refresh();
    browser.hidden = false;
    allDates.addEventListener('click', () => selectWeek(null));
    weekButtons.forEach((button, i) => button.addEventListener('click', () => selectWeek(i)));
    setInterval(refresh, 60_000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refresh();
    });
  }
</script>

<style is:global>
  /* Global: the script rebuilds day sections, which carry no scoped-style ids. */
  .index-summary {
    margin: -0.5rem 0 1.25rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .week-browser {
    container-type: inline-size;
    margin-bottom: 1.75rem;
  }

  .week-browser__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.75rem;
    color: var(--text-secondary);
    font: 0.75rem 'Space Mono', monospace;
  }

  #week-browser-label {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .week-browser__all {
    min-height: 44px;
    padding-inline: 0.4rem;
    text-underline-offset: 0.3em;
    border-radius: 4px;
    cursor: pointer;
  }

  .week-browser__all:is(:hover, [aria-pressed='true']) {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .week-browser__weeks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.375rem;
  }

  @container (min-width: 17rem) {
    .week-browser__weeks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .week-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.4rem 0.2rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    text-align: center;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .week-card:hover {
    border-color: var(--text-secondary);
  }

  .week-card[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 -2px var(--accent);
    background: var(--accent-dim);
  }

  .week-card__name {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .week-card__dates {
    color: var(--text-secondary);
    font: 0.6875rem/1.4 'Space Mono', monospace;
  }

  .week-browser button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .part-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.25rem;
    color: var(--accent);
    font: 700 0.75rem 'Space Mono', monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .part-head__count {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .part-head--muted {
    color: var(--text-secondary);
  }

  .season,
  .days {
    margin-bottom: 2rem;
    container-type: inline-size;
  }

  .row__link {
    display: grid;
    min-height: 44px;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    column-gap: 0.75rem;
  }

  /* Season rows: pictogram, then status line, name and facts. */
  .season-list .row__link {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'picto when' 'picto body';
    row-gap: 0.15rem;
  }

  .season-list .row__picto {
    grid-area: picto;
    align-self: start;
    padding-top: 0.15rem;
    color: var(--text-secondary);
  }

  .season-list .row.is-open .row__picto {
    color: var(--text-primary);
  }

  .season-list .row__when {
    grid-area: when;
    color: var(--text-secondary);
    font: 0.75rem 'Space Mono', monospace;
  }

  .season-list .row.is-open .row__when {
    color: var(--text-data);
    font-weight: 700;
  }

  .season-list .row__body {
    grid-area: body;
  }

  /* Day agenda: the red thread with a stop per occasion; time, then body. */
  .day {
    margin-top: 1rem;
    scroll-margin-top: 1rem;
  }

  .day__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.6rem;
    margin-bottom: 0.25rem;
    font: 700 0.8125rem 'Space Mono', monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .day__rel {
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 400;
  }

  .day-list {
    margin-left: 0.35rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
  }

  .day-list .row {
    position: relative;
  }

  .day-list .row::before {
    content: '';
    position: absolute;
    top: 1.05rem;
    left: calc(-1.1rem - 6px);
    width: 10px;
    height: 10px;
    background: var(--bg-primary);
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  .day-list .row:last-child .row__link {
    border-bottom: 0;
  }

  .day-list .row__link {
    grid-template-columns: 5.4rem minmax(0, 1fr) auto;
    grid-template-areas: 'when body picto';
  }

  .day-list .row__when {
    grid-area: when;
    padding-top: 0.1rem;
    color: var(--text-data);
    font: 700 0.6875rem 'Space Mono', monospace;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .day-list .row__body {
    grid-area: body;
  }

  .day-list .row__picto {
    grid-area: picto;
    color: var(--text-secondary);
  }

  .row__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .row__name {
    color: var(--text-primary);
    font: 700 0.9375rem/1.2 'Space Mono', monospace;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .row__link:hover .row__name {
    color: var(--accent);
  }

  .row__sub {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.35rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .row__tag {
    padding: 0 0.4rem;
    border: 1px solid var(--accent);
    border-radius: 3px;
    font: 0.6875rem 'Space Mono', monospace;
  }

  @container (max-width: 20rem) {
    .day-list .row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'when picto' 'body body';
    }
  }

  .index-empty {
    padding: 2rem 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .index-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .index-empty__action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
  }
</style>
