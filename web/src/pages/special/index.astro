---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import OccasionStatus from '../../components/OccasionStatus.astro';
import ActiveOccasion from '../../components/ActiveOccasion.astro';
import Footer from '../../components/Footer.astro';
import { loadEventData } from '../../data/loader';
import { WEEK_NAMES, indexAdmission, indexDates, occasionIndex } from '../../utils/occasionIndex';

const eventData = loadEventData();
const { meta, occasions } = eventData;
// Grouped on the build clock. Dated headings show only their dates here, so
// they stay true however long the page is served; the script below regroups
// on the reader's clock and names them Today / Next 7 days.
const groups = occasionIndex(occasions, new Date());
groups.unshift({ key: 'week', name: '', dates: null, entries: [] });
---

<Base
  title="City Occasions · boringhannover"
  description="Festivals, neighbourhood gatherings and one-off city moments in Hannover, kept separate from the weekly event digest."
>
  <Header week={meta.week} year={meta.year} brandAsHeading={false} />

  <nav class="mb-6" aria-label="Breadcrumb">
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-display text-[11px] uppercase tracking-wide text-text-secondary hover:text-accent"
    >
      ← Back to the weekly digest
    </a>
  </nav>

  <section class="occasion-index" aria-labelledby="city-occasions">
    <SectionHeader id="city-occasions" title="City Occasions" as="h1" />
    <p class="mb-6 text-sm text-text-secondary">Festivals and city occasions for the next 30 days.</p>

    <div class="week-browser" role="group" aria-labelledby="week-browser-label" hidden>
      <div class="week-browser__header">
        <span id="week-browser-label">Browse by week</span>
        <button class="week-browser__all" type="button" data-index-all aria-pressed="true">All dates</button>
      </div>
      <div class="week-browser__weeks">
        {WEEK_NAMES.map((name) => (
          <button class="week-card" type="button" data-index-week aria-pressed="false">
            <span class="week-card__name">{name}</span>
            <span class="week-card__dates" data-week-dates></span>
          </button>
        ))}
      </div>
      <p class="sr-only" data-index-results role="status"></p>
    </div>

    {groups.map((group) => (
      <section
        class:list={['index-group', `index-group--${group.key}`]}
        data-index-group={group.key}
        aria-labelledby={`index-${group.key}`}
        hidden={group.entries.length === 0}
      >
        <h2 id={`index-${group.key}`} class="index-group__heading">
          <span class="index-group__name" data-index-name>{group.dates ? null : group.name}</span>
          <span class="index-group__dates" data-index-dates>{group.dates}</span>
        </h2>
        <ol class="index-list" data-index-list>
          {group.entries.map((entry) => {
            const { occasion } = entry;
            const { when, span } = indexDates(entry);
            const admission = indexAdmission(occasion);
            const dayTrip =
              occasion.area === 'region' && occasion.place?.municipality
                ? `Day trip · ${occasion.place.municipality}`
                : null;
            return (
              <ActiveOccasion slug={occasion.slug}>
                <li class="index-item" data-index-row>
                  <a
                    href={`/special/${occasion.slug}/`}
                    class="index-item__link"
                    data-umami-event="occasion-open"
                    data-umami-event-occasion={occasion.slug}
                  >
                    <span class="index-item__when">
                      <span class="index-item__status" data-index-source-status={occasion.sourceStatus}>
                        <OccasionStatus occasion={occasion} />
                        <span aria-hidden="true">·</span>
                      </span>
                      <span data-index-when>{when}</span>
                    </span>
                    {/* Occasion names are the source's German proper names. */}
                    <span class="index-item__name" lang="de" data-index-row-name>{occasion.name}</span>
                    <span class="index-item__facts">
                      <span lang="de">{occasion.place?.venue ?? occasion.location}</span>
                      {dayTrip && <span class="index-item__tag">{dayTrip}</span>}
                      {admission && <span class="index-item__admission">{admission}</span>}
                      {occasion.programmeCount > 0 && (
                        <span>{occasion.programmeCount} programme items</span>
                      )}
                    </span>
                    <span class="index-item__span" data-index-span hidden={!span}>{span}</span>
                  </a>
                </li>
              </ActiveOccasion>
            );
          })}
        </ol>
      </section>
    ))}

    <div class="index-empty" data-index-empty>
      <p data-index-empty-text>No City Occasions are listed for the next 30 days.</p>
      <div class="index-empty__actions">
        <a href="/" class="index-empty__action">Weekly digest</a>
        <a
          href="https://www.hannover.de/Veranstaltungskalender/Feste-Festivals"
          target="_blank"
          rel="noopener noreferrer"
          class="index-empty__action"
        >Festival listing on hannover.de<span aria-hidden="true">&nbsp;↗</span></a>
      </div>
    </div>
  </section>

  <Footer updatedAt={meta.updatedAt} />
</Base>

<script>
  import {
    indexDates,
    occasionIndex,
    occasionIndexForWeek,
    occasionWeeks,
    type IndexOccasion,
  } from '../../utils/occasionIndex';
  import { berlinClock, occasionLabel, type OccasionSchedule } from '../../utils/occasionStatus';

  const browser = document.querySelector<HTMLElement>('.week-browser')!;
  const allDates = browser.querySelector<HTMLButtonElement>('[data-index-all]')!;
  const weekButtons = Array.from(browser.querySelectorAll<HTMLButtonElement>('[data-index-week]'));
  const weekLabels = weekButtons.map(button => button.querySelector('[data-week-dates]')!);
  const sections = document.querySelectorAll<HTMLElement>('[data-index-group]');
  const announcement = document.querySelector('[data-index-results]')!;
  const emptyText = document.querySelector('[data-index-empty-text]')!;
  const allDatesEmptyText = emptyText.textContent;
  const rows: Array<IndexOccasion & { element: HTMLElement; status: HTMLElement; link: HTMLAnchorElement }> = Array.from(
    document.querySelectorAll<HTMLElement>('[data-index-row]'),
    (element) => {
      const status = element.querySelector<HTMLElement>('[data-occasion-schedule]')!;
      return {
        ...JSON.parse(status.dataset.occasionSchedule!) as OccasionSchedule,
        name: element.querySelector('[data-index-row-name]')!.textContent!,
        link: element.querySelector<HTMLAnchorElement>('.index-item__link')!,
        element,
        status,
      };
    },
  );
  let selectedWeek: number | null = null;

  function refreshIndex() {
    const now = new Date();
    const weeks = occasionWeeks(berlinClock(now).date);
    const week = selectedWeek === null ? null : weeks[selectedWeek];
    const groups = week ? [occasionIndexForWeek(rows, now, week)] : occasionIndex(rows, now);
    weekLabels.forEach((label, i) => {
      if (label.textContent !== weeks[i].dates) label.textContent = weeks[i].dates;
    });
    const focused = document.activeElement;
    const placed = new Set<HTMLElement>();
    for (const section of sections) {
      const group = groups.find(group => group.key === section.dataset.indexGroup);
      section.hidden = !group?.entries.length;
      if (!group?.entries.length) continue;
      section.querySelector('[data-index-name]')!.textContent = group.name;
      section.querySelector('[data-index-dates]')!.textContent = group.dates ?? '';
      const list = section.querySelector('[data-index-list]')!;
      group.entries.forEach((entry, position) => {
        const { element, link, status } = entry.occasion;
        const href = week && entry.appointment
          ? `${link.pathname}?date=${entry.appointment.date}`
          : link.pathname;
        if (link.getAttribute('href') !== href) link.setAttribute('href', href);
        const label = occasionLabel(entry.occasion, now);
        if (status.textContent !== label.text) {
          status.textContent = label.text;
          status.dataset.state = label.key;
        }
        const { when, span } = indexDates(entry);
        const spanElement = element.querySelector<HTMLElement>('[data-index-span]')!;
        element.querySelector('[data-index-when]')!.textContent = when;
        spanElement.textContent = span ?? '';
        spanElement.hidden = !span;
        element.hidden = false;
        // Only move rows that are out of place: moving a node drops focus.
        if (list.children[position] !== element) {
          list.insertBefore(element, list.children[position] ?? null);
        }
        placed.add(element);
      });
    }
    for (const { element } of rows) {
      if (!placed.has(element)) element.hidden = true;
    }
    if (focused instanceof HTMLElement && focused.closest('[data-index-row]')) {
      if (focused.closest('[hidden]')) buttonFor(selectedWeek).focus();
      else if (focused !== document.activeElement) focused.focus({ preventScroll: true });
    }
    const emptyMessage = week ? `No upcoming confirmed occasions for ${week.dates}.` : allDatesEmptyText;
    if (emptyText.textContent !== emptyMessage) emptyText.textContent = emptyMessage;
    const count = placed.size;
    const result = week
      ? `${count} ${count === 1 ? 'occasion' : 'occasions'} · ${week.name}, ${week.dates}.`
      : 'Showing all dates.';
    if ((week || announcement.textContent) && announcement.textContent !== result) {
      announcement.textContent = result;
    }
  }

  function buttonFor(index: number | null) {
    return index === null ? allDates : weekButtons[index];
  }

  function selectWeek(week: number | null) {
    if (selectedWeek === week) return;
    buttonFor(selectedWeek).setAttribute('aria-pressed', 'false');
    selectedWeek = week;
    buttonFor(selectedWeek).setAttribute('aria-pressed', 'true');
    refreshIndex();
  }

  if (rows.length > 0) {
    refreshIndex();
    browser.hidden = false;
    allDates.addEventListener('click', () => selectWeek(null));
    weekButtons.forEach((button, i) => button.addEventListener('click', () => selectWeek(i)));
    setInterval(refreshIndex, 60_000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refreshIndex();
    });
  }
</script>

<style>
  .week-browser {
    container-type: inline-size;
    margin-bottom: 1.5rem;
  }

  .week-browser__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.75rem;
    color: var(--text-secondary);
    font: 0.75rem 'Space Mono', monospace;
  }

  #week-browser-label {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .week-browser__all {
    min-height: 44px;
    padding-inline: 0.4rem;
    text-underline-offset: 0.3em;
    border-radius: 4px;
    cursor: pointer;
  }

  .week-browser__all:is(:hover, [aria-pressed='true']) {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .week-browser__weeks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.375rem;
  }

  @container (min-width: 17rem) {
    .week-browser__weeks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .week-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.4rem 0.2rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
    text-align: center;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .week-card:hover {
    border-color: var(--text-secondary);
  }

  .week-card[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 -2px var(--accent);
    background: var(--accent-dim);
  }

  .week-card__name {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .week-card__dates {
    color: var(--text-secondary);
    font: 0.6875rem/1.4 'Space Mono', monospace;
  }

  .week-browser button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .index-group {
    margin-bottom: 2rem;
  }

  .index-group:not(:has(.index-item:not([hidden]))),
  .occasion-index:has(.index-item:not([hidden])) .index-empty {
    display: none;
  }

  .index-group__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.6rem;
    margin-bottom: 0.4rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .index-group__name {
    color: var(--accent);
    font-weight: 700;
  }

  .index-group__name:empty {
    display: none;
  }

  .index-group--check .index-group__name,
  .index-group--off .index-group__name {
    color: var(--text-secondary);
  }

  .index-group__dates {
    color: var(--text-secondary);
  }

  /* The red thread: one line per group, a stop per occasion. */
  .index-list {
    margin-left: 0.35rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
  }

  .index-group--check .index-list,
  .index-group--off .index-list {
    border-left-color: var(--border);
  }

  .index-item {
    position: relative;
  }

  .index-item::before {
    content: '';
    position: absolute;
    top: 1.05rem;
    left: calc(-1.1rem - 6px);
    width: 10px;
    height: 10px;
    background: var(--bg-primary);
    border: 2px solid var(--accent);
    border-radius: 50%;
  }

  .index-group--check .index-item::before,
  .index-group--off .index-item::before {
    border-color: var(--text-muted);
  }

  .index-item__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
    min-height: 44px;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .index-item:last-child .index-item__link {
    border-bottom: 0;
  }

  .index-item__when {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.4rem;
    color: var(--text-secondary);
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
  }

  .index-item__status {
    display: inline-flex;
    gap: inherit;
  }

  .index-group--week .index-item__status:not([data-index-source-status='rescheduled']) {
    display: none;
  }

  .index-item__name {
    color: var(--text-primary);
    font-family: 'Space Mono', monospace;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  .index-item__link:hover .index-item__name {
    color: var(--accent);
  }

  .index-group--off .index-item__name {
    color: var(--text-secondary);
  }

  .index-item__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.5rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .index-item__tag {
    padding: 0 0.4rem;
    border: 1px solid var(--accent);
    border-radius: 3px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
  }

  .index-item__admission {
    color: var(--text-primary);
  }

  .index-item__span {
    color: var(--text-secondary);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
  }

  .index-empty {
    padding: 2rem 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .index-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .index-empty__action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.9rem;
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
  }

  .index-empty__action:hover {
    border-color: var(--accent);
  }
</style>
