---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OccasionStatus from '../../components/OccasionStatus.astro';
import {
  loadEventData,
  loadOccasionProgramme,
} from '../../data/loader';
import type {
  Concert,
  OccasionProgramme,
  OccasionSummary,
} from '../../data/types';
import { sanitizeUrl } from '../../utils/sanitize';
import { formatEventTime } from '../../utils/displayLabels';
import { occasionJsonLd } from '../../utils/occasionJsonLd';
import { occasionSourceLink } from '../../utils/occasionSource';
import {
  entryPrice,
  mapUrl,
  onwardOccasions,
  placeAddress,
  sheetDateLine,
  whenFacts,
} from '../../utils/occasionSheet';
import { berlinClock } from '../../utils/occasionStatus';

interface Props {
  programmeData: OccasionProgramme;
  occasions: OccasionSummary[];
  week: number;
  year: number;
}

export function getStaticPaths() {
  const eventData = loadEventData();

  return eventData.occasions.map((occasion) => {
    const programmeData = loadOccasionProgramme(occasion.programmePath) ?? {
      meta: { updatedAt: eventData.meta.updatedAt },
      occasion,
      programme: [],
    };

    return {
      params: { slug: occasion.slug },
      props: {
        programmeData,
        occasions: eventData.occasions,
        week: eventData.meta.week,
        year: eventData.meta.year,
      },
    };
  });
}

const { programmeData, occasions, week, year } = Astro.props;
const { occasion, programme } = programmeData;

function dateValue(isoDate: string): Date {
  return new Date(`${isoDate}T12:00:00`);
}

function shortDate(isoDate: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
  }).format(dateValue(isoDate)).toUpperCase();
}

function longDate(isoDate: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
  }).format(dateValue(isoDate));
}

// The sheet (#54): decision facts first, every row only when the source
// states it. Unknown facts and unsafe actions are left out, not guessed.
const when = whenFacts(occasion);
const { place } = occasion;
const dayTrip =
  occasion.area === 'region' && place?.municipality
    ? `Day trip · ${place.municipality}`
    : null;
const admission = occasion.admission ?? [];
const freeEntry =
  admission.length === 1 && admission[0].price === 'free' && !admission[0].label;
const source = occasionSourceLink(occasion.sourceUrl);
// Cancelled or undated postponed occasions keep their facts, not actions;
// the browser also drops them once the occasion has ended.
const actionable =
  occasion.sourceStatus !== 'cancelled' && occasion.sourceStatus !== 'postponed';
const address = place ? placeAddress(place) : null;
const onward = onwardOccasions(occasion, occasions, berlinClock(new Date()).date);

const groups = new Map<string, Concert[]>();
for (const event of programme) {
  if (!event.dateISO) continue;
  const events = groups.get(event.dateISO) ?? [];
  events.push(event);
  groups.set(event.dateISO, events);
}
const dateGroups = Array.from(groups, ([dateISO, events]) => ({
  dateISO,
  events,
}));

function countedOptions(values: Array<string | null | undefined>) {
  const counts = new Map<string, number>();
  for (const value of values) {
    if (!value) continue;
    counts.set(value, (counts.get(value) ?? 0) + 1);
  }
  return Array.from(counts, ([label, count]) => ({ label, count }))
    .sort((left, right) => left.label.localeCompare(right.label));
}

const categories = countedOptions(
  programme.map(event => event.programmeCategory),
);
const venues = countedOptions(programme.map(event => event.venue));

// English metadata that names the authoritative event; the fallback
// description already starts with the name.
const summary = occasion.description.includes(occasion.name)
  ? occasion.description
  : `${occasion.name}: ${occasion.description}`;
const description = occasion.programmeCount > 0
  ? `${summary} Explore the official programme by day, category, and location.`
  : summary;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;

// Google only supports Event markup on single-event pages, which is exactly
// what these are. The listing pages deliberately get none.
const eventJsonLd = occasionJsonLd(occasion, {
  canonicalUrl,
  officialUrl: source?.url ?? null,
});
---

<Base
  title={`${occasion.name} · City Occasion · boringhannover`}
  description={description}
  jsonLd={eventJsonLd}
>
  <Header week={week} year={year} brandAsHeading={false} />

  <a href="/" class="occasion-back">
    <span aria-hidden="true">←</span>
    <span>Weekly digest</span>
  </a>

  <article class="sheet" aria-labelledby="occasion-title">
    <header class="sheet__head">
      <p class="sheet__kicker">City Occasion</p>
      <!-- Occasion names are the source's German proper names. -->
      <h1 id="occasion-title" lang="de">{occasion.name}</h1>
      <p class="sheet__status">
        <span class="sheet__status-label">
          <span class="sheet__status-dot" aria-hidden="true"></span>
          <OccasionStatus occasion={occasion} />
        </span>
        <span aria-hidden="true">·</span>
        <span>{sheetDateLine(occasion)}</span>
      </p>
    </header>

    <dl class="sheet__facts">
      <div class="fact">
        <dt>When</dt>
        <dd>
          {when.range && <p>{when.range}</p>}
          {when.selectedDatesOnly && (
            <p class="fact__note">Selected dates only:</p>
          )}
          {when.appointments.length > 0 && (
            <ul class="fact__list">
              {when.appointments.map((appointment) => (
                <li data-occurrence-date={appointment.date}>
                  <time datetime={appointment.datetime}>{appointment.text}</time>
                </li>
              ))}
            </ul>
          )}
          {when.sourceHours && (
            <p class="fact__note">
              Source schedule: <span lang="de">{when.sourceHours}</span>
            </p>
          )}
        </dd>
      </div>

      <div class="fact">
        <dt>Where</dt>
        <dd>
          {place ? (
            <p class="fact__lines">
              {place.venue && <span>{place.venue}</span>}
              <span>{place.street}</span>
              <span>{place.postalCode} {place.locality}</span>
            </p>
          ) : (
            <p>{occasion.location}</p>
          )}
          {dayTrip && <p class="fact__tag">{dayTrip}</p>}
        </dd>
      </div>

      {admission.length > 0 && (
        <div class="fact">
          <dt>Entry</dt>
          <dd>
            {freeEntry ? (
              <p>Free entry</p>
            ) : (
              <>
                <ul class="fact__list">
                  {admission.map((item) => (
                    <li>
                      {item.label && <><span lang="de">{item.label}</span>: </>}
                      <strong>{entryPrice(item.price)}</strong>
                    </li>
                  ))}
                </ul>
                <p class="fact__note">As listed by the source.</p>
              </>
            )}
          </dd>
        </div>
      )}

      {source && (
        <div class="fact">
          <dt>Source</dt>
          <dd>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="fact__link"
              data-umami-event="occasion-source-open"
              data-umami-event-occasion={occasion.slug}
            >{source.label}<span aria-hidden="true">&nbsp;↗</span></a>
          </dd>
        </div>
      )}
    </dl>

    {actionable && (
      <div class="sheet__actions" data-occasion-actions>
        {place && (
          <a
            href={mapUrl(place)}
            target="_blank"
            rel="noopener noreferrer"
            class="sheet__action"
            aria-label={`Map: ${address} on OpenStreetMap`}
            data-umami-event="occasion-directions-open"
            data-umami-event-occasion={occasion.slug}
          >Map<span aria-hidden="true">&nbsp;↗</span></a>
        )}
        {address && (
          <button
            type="button"
            class="sheet__action"
            data-copy-address={address}
            hidden
          >Copy address</button>
        )}
        <button
          type="button"
          class="sheet__action"
          data-share
          data-share-title={occasion.name}
          data-umami-event="occasion-share"
          data-umami-event-occasion={occasion.slug}
          hidden
        >Share</button>
        <p class="sr-only" role="status" data-action-status></p>
      </div>
    )}

    <section class="sheet__about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <p>{occasion.description}</p>
      {source && (
        <p class="sheet__provenance">
          Facts from the {source.label.charAt(0).toLowerCase() + source.label.slice(1)},
          checked {programmeData.meta.updatedAt}.
        </p>
      )}
    </section>
  </article>

  {programme.length > 0 && (
    <section class="programme" aria-labelledby="programme-title">
      <div class="programme__heading">
        <div>
          <p class="programme__kicker">Find your moment</p>
          <h2 id="programme-title">Programme</h2>
        </div>
        <p id="programme-result-count" class="programme__result-count" aria-live="polite">
          {programme.length} events
        </p>
      </div>

      <div class="programme__quick-filters" aria-label="Quick time filters">
        {[
          ['all', 'All'],
          ['today', 'Today'],
          ['tonight', 'Tonight'],
          ['weekend', 'Weekend'],
        ].map(([value, label]) => (
          <button
            type="button"
            data-mode-filter={value}
            aria-pressed={value === 'all' ? 'true' : 'false'}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="programme__date-filter scrollbar-hide" aria-label="Choose a date">
        <button type="button" data-date-filter="all" aria-pressed="true">
          <span>Any</span>
          <strong>Date</strong>
        </button>
        {dateGroups.map(({ dateISO }) => (
          <button type="button" data-date-filter={dateISO} aria-pressed="false">
            <span>{new Intl.DateTimeFormat('en-GB', { weekday: 'short' }).format(dateValue(dateISO))}</span>
            <strong>{shortDate(dateISO)}</strong>
          </button>
        ))}
      </div>

      <div class="programme__refine">
        {categories.length > 0 && (
          <div class="programme__categories" aria-label="Programme categories">
            <button
              type="button"
              data-category-filter="all"
              aria-pressed="true"
            >
              All <span>{programme.length}</span>
            </button>
            {categories.map(({ label, count }) => (
              <button
                type="button"
                data-category-filter={label}
                aria-pressed="false"
              >
                {label} <span>{count}</span>
              </button>
            ))}
          </div>
        )}

        {venues.length > 1 && (
          <label class="programme__venue">
            <span>Location</span>
            <select id="programme-venue-filter">
              <option value="all">Everywhere · {venues.length}</option>
              {venues.map(({ label, count }) => (
                <option value={label}>{label} · {count}</option>
              ))}
            </select>
          </label>
        )}
      </div>

      <div id="programme-list" class="programme__list">
        {dateGroups.map(({ dateISO, events }) => (
          <section
            class="programme-day"
            data-programme-day={dateISO}
            aria-labelledby={`programme-day-${dateISO}`}
          >
            <header class="programme-day__header">
              <p>{new Intl.DateTimeFormat('en-GB', { weekday: 'short' }).format(dateValue(dateISO)).toUpperCase()}</p>
              <h3 id={`programme-day-${dateISO}`}>{longDate(dateISO)}</h3>
              <span>{events.length}</span>
            </header>

            <div class="programme-day__events">
              {events.map((event) => {
                const safeUrl = sanitizeUrl(event.url);
                return (
                  <article
                    class="programme-item"
                    data-programme-item
                    data-date={event.dateISO}
                    data-time={event.time ?? ''}
                    data-category={event.programmeCategory ?? ''}
                    data-venue={event.venue}
                  >
                    <div class="programme-item__time">
                      {event.time ? (
                        <time datetime={`${event.dateISO}T${event.time}`}>
                          {formatEventTime(event.time)}
                        </time>
                      ) : (
                        <span>—</span>
                      )}
                      {event.endTime && <small>–{event.endTime}</small>}
                    </div>

                    <div class="programme-item__body">
                      <div class="programme-item__meta">
                        {event.programmeCategory && (
                          <span>{event.programmeCategory}</span>
                        )}
                        <span>{event.venue}</span>
                      </div>
                      <h4>{event.title}</h4>
                      {event.description && <p>{event.description}</p>}
                    </div>

                    {safeUrl !== '#' && (
                      <a
                        href={safeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="programme-item__link"
                        aria-label={`Open official details for ${event.title}`}
                        data-umami-event="occasion-programme-open"
                        data-umami-event-occasion={occasion.slug}
                      >
                        ↗
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <p id="programme-empty" class="programme__empty" hidden>
        Nothing matches this combination yet. Try another day or location.
      </p>

      <button id="programme-more" type="button" class="radar-toggle">
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span><span class="dot">■</span><span class="dot">■</span>
        </span>
        <span class="toggle-text">Show 12 more</span>
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span><span class="dot">■</span><span class="dot">■</span>
        </span>
      </button>
    </section>
  )}

  <nav class="onward" aria-labelledby="onward-title">
    <h2 id="onward-title">More occasions</h2>
    {onward.length > 0 && (
      <ul class="onward__list">
        {onward.map((item) => (
          <li data-onward-item>
            <a
              href={`/special/${item.slug}/`}
              class="onward__link"
              data-umami-event="occasion-onward-open"
              data-umami-event-occasion={item.slug}
            >
              <span class="onward__name" lang="de">{item.name}</span>
              <span class="onward__meta">
                <OccasionStatus occasion={item} />
                <span aria-hidden="true">·</span>
                <span>{sheetDateLine(item)}</span>
                {item.area === 'region' && item.place?.municipality && (
                  <span>· Day trip · {item.place.municipality}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="onward__empty" data-onward-empty hidden={onward.length > 0}>
      No other City Occasions are listed right now.
    </p>
    <a href="/special/" class="sheet__action onward__index" data-umami-event="occasion-index-open">
      All City Occasions
    </a>
  </nav>

  <Footer updatedAt={programmeData.meta.updatedAt} />
</Base>

<script>
  import {
    berlinClock,
    occasionLabel,
    type OccasionSchedule,
  } from '../../utils/occasionStatus';

  // The sheet is complete without JavaScript; this only refreshes what the
  // reader's Berlin clock changes and adds clipboard and share actions.
  function schedule(element: Element | null): OccasionSchedule | null {
    const raw = element?.querySelector<HTMLElement>('[data-occasion-schedule]')
      ?.dataset.occasionSchedule;
    try {
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function refreshSheet() {
    const now = new Date();
    const today = berlinClock(now).date;
    for (const item of document.querySelectorAll<HTMLElement>(
      '[data-occurrence-date]',
    )) {
      item.hidden = (item.dataset.occurrenceDate ?? '') < today;
    }

    const own = schedule(document.querySelector('.sheet__head'));
    const actions = document.querySelector<HTMLElement>('[data-occasion-actions]');
    if (own && actions) {
      actions.hidden = occasionLabel(own, now).key === 'ended';
    }

    let current = 0;
    for (const item of document.querySelectorAll<HTMLElement>(
      '[data-onward-item]',
    )) {
      const itemSchedule = schedule(item);
      const key = itemSchedule ? occasionLabel(itemSchedule, now).key : null;
      item.hidden = key === 'ended' || key === 'check_dates';
      if (!item.hidden) current += 1;
    }
    document
      .querySelector<HTMLElement>('[data-onward-empty]')
      ?.toggleAttribute('hidden', current > 0);
  }

  const actionStatus = document.querySelector<HTMLElement>('[data-action-status]');
  function acknowledge(button: HTMLButtonElement, message: string) {
    // Keep the resting label, so a second click cannot make "copied" stick.
    button.dataset.label ??= button.textContent ?? '';
    button.textContent = message;
    if (actionStatus) actionStatus.textContent = message;
    window.setTimeout(() => {
      button.textContent = button.dataset.label ?? '';
    }, 2000);
  }

  const copyButton = document.querySelector<HTMLButtonElement>(
    '[data-copy-address]',
  );
  if (copyButton && navigator.clipboard) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', () => {
      navigator.clipboard
        .writeText(copyButton.dataset.copyAddress ?? '')
        .then(() => acknowledge(copyButton, 'Address copied'))
        .catch(() => {});
    });
  }

  const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
  const shareUrl =
    document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ??
    window.location.href;
  if (shareButton && typeof navigator.share === 'function') {
    shareButton.hidden = false;
    shareButton.addEventListener('click', () => {
      navigator
        .share({ title: shareButton.dataset.shareTitle, url: shareUrl })
        .catch(() => {});
    });
  } else if (shareButton && navigator.clipboard) {
    shareButton.hidden = false;
    shareButton.textContent = 'Copy link';
    shareButton.addEventListener('click', () => {
      navigator.clipboard
        .writeText(shareUrl)
        .then(() => acknowledge(shareButton, 'Link copied'))
        .catch(() => {});
    });
  }

  refreshSheet();
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refreshSheet();
  });
</script>

<script>
  import type { Concert } from '../../data/types';
  import {
    matchesOccasionFilters,
    type OccasionFilters,
    type OccasionMode,
  } from '../../utils/occasionFilter';

  const PAGE_SIZE = 12;
  const programmeItems = Array.from(
    document.querySelectorAll<HTMLElement>('[data-programme-item]'),
  );
  const programmeDays = Array.from(
    document.querySelectorAll<HTMLElement>('[data-programme-day]'),
  );
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-mode-filter]'),
  );
  const dateButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-date-filter]'),
  );
  const categoryButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'),
  );
  const venueSelect = document.querySelector<HTMLSelectElement>(
    '#programme-venue-filter',
  );
  const moreButton = document.querySelector<HTMLButtonElement>('#programme-more');
  const resultCount = document.querySelector<HTMLElement>(
    '#programme-result-count',
  );
  const emptyState = document.querySelector<HTMLElement>('#programme-empty');

  const filters: OccasionFilters = {
    mode: 'all',
    date: 'all',
    category: 'all',
    venue: 'all',
  };
  let visibleLimit = PAGE_SIZE;

  function eventFromElement(item: HTMLElement): Concert {
    return {
      title: '',
      date: '',
      dateISO: item.dataset.date ?? '',
      day: '',
      time: item.dataset.time || null,
      venue: item.dataset.venue ?? '',
      programmeCategory: item.dataset.category || null,
    };
  }

  function updatePressedState(
    buttons: HTMLButtonElement[],
    dataKey: 'modeFilter' | 'dateFilter' | 'categoryFilter',
    selected: string,
  ) {
    for (const button of buttons) {
      button.setAttribute(
        'aria-pressed',
        String(button.dataset[dataKey] === selected),
      );
    }
  }

  function applyFilters() {
    const now = new Date();
    const matches = programmeItems.filter(item => (
      matchesOccasionFilters(eventFromElement(item), filters, now)
    ));
    let shown = 0;

    for (const item of programmeItems) {
      const matchesFilters = matches.includes(item);
      const isVisible = matchesFilters && shown < visibleLimit;
      item.hidden = !isVisible;
      if (isVisible) shown += 1;
    }

    for (const day of programmeDays) {
      day.hidden = !day.querySelector('[data-programme-item]:not([hidden])');
    }

    if (resultCount) {
      resultCount.textContent = matches.length === shown
        ? `${matches.length} event${matches.length === 1 ? '' : 's'}`
        : `${shown} of ${matches.length} events`;
    }
    emptyState?.toggleAttribute('hidden', matches.length > 0);

    if (moreButton) {
      moreButton.hidden = shown >= matches.length;
      const text = moreButton.querySelector<HTMLElement>('.toggle-text');
      const remaining = matches.length - shown;
      if (text) text.textContent = `Show ${Math.min(PAGE_SIZE, remaining)} more`;
    }
  }

  function resetLimit() {
    visibleLimit = PAGE_SIZE;
  }

  for (const button of modeButtons) {
    button.addEventListener('click', () => {
      filters.mode = (button.dataset.modeFilter ?? 'all') as OccasionMode;
      filters.date = 'all';
      resetLimit();
      updatePressedState(modeButtons, 'modeFilter', filters.mode);
      updatePressedState(dateButtons, 'dateFilter', filters.date);
      applyFilters();
    });
  }

  for (const button of dateButtons) {
    button.addEventListener('click', () => {
      filters.date = button.dataset.dateFilter ?? 'all';
      filters.mode = 'all';
      resetLimit();
      updatePressedState(dateButtons, 'dateFilter', filters.date);
      updatePressedState(modeButtons, 'modeFilter', filters.mode);
      applyFilters();
    });
  }

  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      filters.category = button.dataset.categoryFilter ?? 'all';
      resetLimit();
      updatePressedState(categoryButtons, 'categoryFilter', filters.category);
      applyFilters();
    });
  }

  venueSelect?.addEventListener('change', () => {
    filters.venue = venueSelect.value;
    resetLimit();
    applyFilters();
  });

  moreButton?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    applyFilters();
  });

  const today = new Date();
  const todayISO = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, '0'),
    String(today.getDate()).padStart(2, '0'),
  ].join('-');
  if (programmeItems.some(item => item.dataset.date === todayISO)) {
    filters.mode = 'today';
    updatePressedState(modeButtons, 'modeFilter', filters.mode);
  }

  applyFilters();
</script>

<style>
  .occasion-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin: -0.5rem 0 0.75rem;
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .occasion-back:hover {
    color: var(--accent);
  }

  .sheet {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .sheet__kicker,
  .sheet__about h2,
  .onward h2 {
    color: var(--accent);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Long German names wrap instead of being clipped (#54). */
  .sheet h1 {
    margin-top: 0.5rem;
    font-family: 'Space Mono', monospace;
    font-size: clamp(1.6rem, 8vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .sheet__status {
