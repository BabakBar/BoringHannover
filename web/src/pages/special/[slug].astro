---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  loadEventData,
  loadOccasionProgramme,
} from '../../data/loader';
import type {
  Concert,
  OccasionProgramme,
  OccasionSummary,
} from '../../data/types';
import { sanitizeUrl } from '../../utils/sanitize';

interface Props {
  programmeData: OccasionProgramme;
  week: number;
  year: number;
}

export function getStaticPaths() {
  const eventData = loadEventData();

  return eventData.occasions.map((occasion) => {
    const programmeData = loadOccasionProgramme(occasion.programmePath) ?? {
      meta: { updatedAt: eventData.meta.updatedAt },
      occasion,
      programme: [],
    };

    return {
      params: { slug: occasion.slug },
      props: {
        programmeData,
        week: eventData.meta.week,
        year: eventData.meta.year,
      },
    };
  });
}

const { programmeData, week, year } = Astro.props;
const { occasion, programme } = programmeData;

const statusLabels = {
  upcoming: 'Coming soon',
  happening_now: 'Happening now',
  final_weekend: 'Final weekend',
} as const;

function dateValue(isoDate: string): Date {
  return new Date(`${isoDate}T12:00:00`);
}

function shortDate(isoDate: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
  }).format(dateValue(isoDate)).toUpperCase();
}

function longDate(isoDate: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
  }).format(dateValue(isoDate));
}

const dateRange = `${shortDate(occasion.startDate)} — ${shortDate(occasion.endDate)}`;
const safeSourceUrl = sanitizeUrl(occasion.sourceUrl);

const groups = new Map<string, Concert[]>();
for (const event of programme) {
  if (!event.dateISO) continue;
  const events = groups.get(event.dateISO) ?? [];
  events.push(event);
  groups.set(event.dateISO, events);
}
const dateGroups = Array.from(groups, ([dateISO, events]) => ({
  dateISO,
  events,
}));

function countedOptions(values: Array<string | null | undefined>) {
  const counts = new Map<string, number>();
  for (const value of values) {
    if (!value) continue;
    counts.set(value, (counts.get(value) ?? 0) + 1);
  }
  return Array.from(counts, ([label, count]) => ({ label, count }))
    .sort((left, right) => left.label.localeCompare(right.label));
}

const categories = countedOptions(
  programme.map(event => event.programmeCategory),
);
const venues = countedOptions(programme.map(event => event.venue));

const description = occasion.programmeCount > 0
  ? `${occasion.name}: ${occasion.description} Explore the official programme by day, category, and location.`
  : `${occasion.name}: ${occasion.description} Official event details for Hannover.`;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const officialUrl = occasion.sourceUrl
  ? sanitizeUrl(occasion.sourceUrl)
  : null;

// Google only supports Event markup on single-event pages, which is exactly
// what these are. The listing pages deliberately get none.
const eventJsonLd = occasion.startDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: occasion.name,
      startDate: occasion.startDate,
      ...(occasion.endDate ? { endDate: occasion.endDate } : {}),
      description: occasion.description,
      ...(occasion.imageUrl ? { image: occasion.imageUrl } : {}),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: occasion.location,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Hannover',
          addressCountry: 'DE',
        },
      },
      // url must be the page carrying the markup; the venue's own site is a
      // sameAs reference, not a substitute for it.
      ...(canonicalUrl ? { url: canonicalUrl } : {}),
      ...(officialUrl ? { sameAs: officialUrl } : {}),
    }
  : undefined;
---

<Base
  title={`${occasion.name} · City Occasion · boringhannover`}
  description={description}
  image={occasion.imageUrl ?? undefined}
  imageAlt={`${occasion.name} in Hannover`}
  jsonLd={eventJsonLd}
>
  <Header week={week} year={year} brandAsHeading={false} />

  <a href="/" class="occasion-back">
    <span aria-hidden="true">←</span>
    <span>Weekly digest</span>
  </a>

  <header class="occasion-hero">
    <div class="occasion-hero__topline">
      <span>Special in Hannover</span>
      <span class="occasion-hero__status">
        <span aria-hidden="true"></span>
        {statusLabels[occasion.status]}
      </span>
    </div>

    <p class="occasion-hero__date">{dateRange}</p>
    <h1>{occasion.name}</h1>
    <p class="occasion-hero__description">{occasion.description}</p>

    <div class="occasion-hero__facts">
      <span>{occasion.location}</span>
      <span aria-hidden="true">·</span>
      <span>
        {occasion.programmeCount > 0
          ? `${occasion.programmeCount} programme items`
          : 'Official listing'}
      </span>
      {occasion.locationCount > 0 && (
        <>
          <span aria-hidden="true">·</span>
          <span>{occasion.locationCount} locations</span>
        </>
      )}
    </div>
  </header>

  {programme.length > 0 ? (
    <section class="programme" aria-labelledby="programme-title">
      <div class="programme__heading">
        <div>
          <p class="programme__kicker">Find your moment</p>
          <h2 id="programme-title">Programme</h2>
        </div>
        <p id="programme-result-count" class="programme__result-count" aria-live="polite">
          {programme.length} events
        </p>
      </div>

      <div class="programme__quick-filters" aria-label="Quick time filters">
        {[
          ['all', 'All'],
          ['today', 'Today'],
          ['tonight', 'Tonight'],
          ['weekend', 'Weekend'],
        ].map(([value, label]) => (
          <button
            type="button"
            data-mode-filter={value}
            aria-pressed={value === 'all' ? 'true' : 'false'}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="programme__date-filter scrollbar-hide" aria-label="Choose a date">
        <button type="button" data-date-filter="all" aria-pressed="true">
          <span>Any</span>
          <strong>Date</strong>
        </button>
        {dateGroups.map(({ dateISO }) => (
          <button type="button" data-date-filter={dateISO} aria-pressed="false">
            <span>{new Intl.DateTimeFormat('en-GB', { weekday: 'short' }).format(dateValue(dateISO))}</span>
            <strong>{shortDate(dateISO)}</strong>
          </button>
        ))}
      </div>

      <div class="programme__refine">
        {categories.length > 0 && (
          <div class="programme__categories" aria-label="Programme categories">
            <button
              type="button"
              data-category-filter="all"
              aria-pressed="true"
            >
              All <span>{programme.length}</span>
            </button>
            {categories.map(({ label, count }) => (
              <button
                type="button"
                data-category-filter={label}
                aria-pressed="false"
              >
                {label} <span>{count}</span>
              </button>
            ))}
          </div>
        )}

        {venues.length > 1 && (
          <label class="programme__venue">
            <span>Location</span>
            <select id="programme-venue-filter">
              <option value="all">Everywhere · {venues.length}</option>
              {venues.map(({ label, count }) => (
                <option value={label}>{label} · {count}</option>
              ))}
            </select>
          </label>
        )}
      </div>

      <div id="programme-list" class="programme__list">
        {dateGroups.map(({ dateISO, events }) => (
          <section
            class="programme-day"
            data-programme-day={dateISO}
            aria-labelledby={`programme-day-${dateISO}`}
          >
            <header class="programme-day__header">
              <p>{new Intl.DateTimeFormat('en-GB', { weekday: 'short' }).format(dateValue(dateISO)).toUpperCase()}</p>
              <h3 id={`programme-day-${dateISO}`}>{longDate(dateISO)}</h3>
              <span>{events.length}</span>
            </header>

            <div class="programme-day__events">
              {events.map((event) => {
                const safeUrl = sanitizeUrl(event.url);
                return (
                  <article
                    class="programme-item"
                    data-programme-item
                    data-date={event.dateISO}
                    data-time={event.time ?? ''}
                    data-category={event.programmeCategory ?? ''}
                    data-venue={event.venue}
                  >
                    <div class="programme-item__time">
                      {event.time ? (
                        <time datetime={`${event.dateISO}T${event.time}`}>
                          {event.time}
                        </time>
                      ) : (
                        <span>—</span>
                      )}
                      {event.endTime && <small>–{event.endTime}</small>}
                    </div>

                    <div class="programme-item__body">
                      <div class="programme-item__meta">
                        {event.programmeCategory && (
                          <span>{event.programmeCategory}</span>
                        )}
                        <span>{event.venue}</span>
                      </div>
                      <h4>{event.title}</h4>
                      {event.description && <p>{event.description}</p>}
                    </div>

                    {safeUrl !== '#' && (
                      <a
                        href={safeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="programme-item__link"
                        aria-label={`Open official details for ${event.title}`}
                        data-umami-event="occasion-programme-open"
                        data-umami-event-occasion={occasion.slug}
                      >
                        ↗
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <p id="programme-empty" class="programme__empty" hidden>
        Nothing matches this combination yet. Try another day or location.
      </p>

      <button id="programme-more" type="button" class="radar-toggle">
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span><span class="dot">■</span><span class="dot">■</span>
        </span>
        <span class="toggle-text">Show 12 more</span>
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span><span class="dot">■</span><span class="dot">■</span>
        </span>
      </button>
    </section>
  ) : (
    <section class="programme-empty-state">
      <p class="programme__kicker">Programme update</p>
      <h2>The occasion is here. The detailed programme is catching up.</h2>
      <p>
        The official source is still the best place for the latest details.
        BoringHannover will attach the full programme automatically when the
        structured listing is available again.
      </p>
    </section>
  )}

  {safeSourceUrl !== '#' && (
    <a
      href={safeSourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="occasion-source"
      data-umami-event="occasion-source-open"
      data-umami-event-occasion={occasion.slug}
    >
      <span>Official {occasion.name} website</span>
      <span aria-hidden="true">↗</span>
    </a>
  )}

  <Footer updatedAt={programmeData.meta.updatedAt} />
</Base>

<script>
  import type { Concert } from '../../data/types';
  import {
    matchesOccasionFilters,
    type OccasionFilters,
    type OccasionMode,
  } from '../../utils/occasionFilter';

  const PAGE_SIZE = 12;
  const programmeItems = Array.from(
    document.querySelectorAll<HTMLElement>('[data-programme-item]'),
  );
  const programmeDays = Array.from(
    document.querySelectorAll<HTMLElement>('[data-programme-day]'),
  );
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-mode-filter]'),
  );
  const dateButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-date-filter]'),
  );
  const categoryButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'),
  );
  const venueSelect = document.querySelector<HTMLSelectElement>(
    '#programme-venue-filter',
  );
  const moreButton = document.querySelector<HTMLButtonElement>('#programme-more');
  const resultCount = document.querySelector<HTMLElement>(
    '#programme-result-count',
  );
  const emptyState = document.querySelector<HTMLElement>('#programme-empty');

  const filters: OccasionFilters = {
    mode: 'all',
    date: 'all',
    category: 'all',
    venue: 'all',
  };
  let visibleLimit = PAGE_SIZE;

  function eventFromElement(item: HTMLElement): Concert {
    return {
      title: '',
      date: '',
      dateISO: item.dataset.date ?? '',
      day: '',
      time: item.dataset.time || null,
      venue: item.dataset.venue ?? '',
      programmeCategory: item.dataset.category || null,
    };
  }

  function updatePressedState(
    buttons: HTMLButtonElement[],
    dataKey: 'modeFilter' | 'dateFilter' | 'categoryFilter',
    selected: string,
  ) {
    for (const button of buttons) {
      button.setAttribute(
        'aria-pressed',
        String(button.dataset[dataKey] === selected),
      );
    }
  }

  function applyFilters() {
    const now = new Date();
    const matches = programmeItems.filter(item => (
      matchesOccasionFilters(eventFromElement(item), filters, now)
    ));
    let shown = 0;

    for (const item of programmeItems) {
      const matchesFilters = matches.includes(item);
      const isVisible = matchesFilters && shown < visibleLimit;
      item.hidden = !isVisible;
      if (isVisible) shown += 1;
    }

    for (const day of programmeDays) {
      day.hidden = !day.querySelector('[data-programme-item]:not([hidden])');
    }

    if (resultCount) {
      resultCount.textContent = matches.length === shown
        ? `${matches.length} event${matches.length === 1 ? '' : 's'}`
        : `${shown} of ${matches.length} events`;
    }
    emptyState?.toggleAttribute('hidden', matches.length > 0);

    if (moreButton) {
      moreButton.hidden = shown >= matches.length;
      const text = moreButton.querySelector<HTMLElement>('.toggle-text');
      const remaining = matches.length - shown;
      if (text) text.textContent = `Show ${Math.min(PAGE_SIZE, remaining)} more`;
    }
  }

  function resetLimit() {
    visibleLimit = PAGE_SIZE;
  }

  for (const button of modeButtons) {
    button.addEventListener('click', () => {
      filters.mode = (button.dataset.modeFilter ?? 'all') as OccasionMode;
      filters.date = 'all';
      resetLimit();
      updatePressedState(modeButtons, 'modeFilter', filters.mode);
      updatePressedState(dateButtons, 'dateFilter', filters.date);
      applyFilters();
    });
  }

  for (const button of dateButtons) {
    button.addEventListener('click', () => {
      filters.date = button.dataset.dateFilter ?? 'all';
      filters.mode = 'all';
      resetLimit();
      updatePressedState(dateButtons, 'dateFilter', filters.date);
      updatePressedState(modeButtons, 'modeFilter', filters.mode);
      applyFilters();
    });
  }

  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      filters.category = button.dataset.categoryFilter ?? 'all';
      resetLimit();
      updatePressedState(categoryButtons, 'categoryFilter', filters.category);
      applyFilters();
    });
  }

  venueSelect?.addEventListener('change', () => {
    filters.venue = venueSelect.value;
    resetLimit();
    applyFilters();
  });

  moreButton?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    applyFilters();
  });

  const today = new Date();
  const todayISO = [
    today.getFullYear(),
    String(today.getMonth() + 1).padStart(2, '0'),
    String(today.getDate()).padStart(2, '0'),
  ].join('-');
  if (programmeItems.some(item => item.dataset.date === todayISO)) {
    filters.mode = 'today';
    updatePressedState(modeButtons, 'modeFilter', filters.mode);
  }

  applyFilters();
</script>

<style>
  .occasion-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    margin: -0.5rem 0 0.75rem;
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .occasion-back:hover {
    color: var(--accent);
  }

  .occasion-hero {
    position: relative;
    overflow: hidden;
    padding: 1.25rem 0 2rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .occasion-hero::after {
    content: '';
    position: absolute;
    top: 2.5rem;
    right: -5rem;
    width: 11rem;
    height: 11rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: 50%;
    opacity: 0.55;
    pointer-events: none;
  }

  .occasion-hero__topline,
  .occasion-hero__facts {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .occasion-hero__topline {
    justify-content: space-between;
    color: var(--accent);
  }

  .occasion-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
  }

  .occasion-hero__status span {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }

  .occasion-hero__date {
    position: relative;
    z-index: 1;
    margin-top: 2.4rem;
    color: var(--text-data);
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .occasion-hero h1 {
    position: relative;
    z-index: 1;
    max-width: 24rem;
    margin-top: 0.3rem;
    font-family: 'Space Mono', monospace;
    font-size: clamp(2.2rem, 13vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .occasion-hero__description {
    position: relative;
    z-index: 1;
    max-width: 24rem;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .occasion-hero__facts {
    margin-top: 1rem;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .programme {
    margin-top: 2.5rem;
  }

  .programme__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .programme__kicker {
    color: var(--accent);
    font-family: 'Space Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .programme__heading h2,
  .programme-empty-state h2 {
    margin-top: 0.15rem;
    font-family: 'Space Mono', monospace;
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .programme__result-count {
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .programme__quick-filters,
  .programme__categories {
    display: flex;
    gap: 0.45rem;
    padding-bottom: 0.3rem;
    overflow-x: auto;
  }

  .programme__quick-filters button,
  .programme__categories button {
    min-height: 38px;
    padding: 0.5rem 0.7rem;
    flex: 0 0 auto;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .programme__quick-filters button[aria-pressed='true'],
  .programme__categories button[aria-pressed='true'] {
    color: var(--text-primary);
    background: var(--accent-dim);
    border-color: var(--accent);
  }

  .programme__categories button span {
    margin-left: 0.2rem;
    color: var(--text-muted);
  }

  .programme__date-filter {
    display: flex;
    gap: 0.45rem;
    margin: 1rem -1rem 0;
    padding: 0 1rem 0.45rem;
    overflow-x: auto;
  }

  .programme__date-filter button {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 4.25rem;
    min-height: 54px;
    padding: 0.45rem 0.65rem;
    flex: 0 0 auto;
    color: var(--text-muted);
    background: var(--bg-secondary);
    border: 1px solid transparent;
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    text-align: left;
  }

  .programme__date-filter button span {
    font-size: 0.5625rem;
    text-transform: uppercase;
  }

  .programme__date-filter button strong {
    margin-top: 0.1rem;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .programme__date-filter button[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-dim);
    border-color: var(--accent);
  }

  .programme__date-filter button[aria-pressed='true'] strong {
    color: var(--text-primary);
  }

  .programme__refine {
    margin-top: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .programme__venue {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }

  .programme__venue > span {
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .programme__venue select {
    min-height: 44px;
    padding: 0.6rem 2.2rem 0.6rem 0.7rem;
    color: var(--text-primary);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
  }

  .programme__list {
    margin-top: 1.5rem;
  }

  .programme-day {
    margin-bottom: 2rem;
  }

  .programme-day__header {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.65rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--accent);
  }

  .programme-day__header p,
  .programme-day__header span {
    color: var(--text-muted);
    font-family: 'Space Mono', monospace;
    font-size: 0.625rem;
  }

  .programme-day__header h3 {
    font-family: 'Space Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .programme-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 2rem;
    gap: 0.65rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .programme-item__time {
    color: var(--text-data);
    font-family: 'Space Mono', monospace;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .programme-item__time small {
    display: block;
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.5625rem;
  }

  .programme-item__body {
