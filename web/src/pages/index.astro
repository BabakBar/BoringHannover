---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SectionHeader from '../components/SectionHeader.astro';
import DateHeader from '../components/DateHeader.astro';
import MovieCard from '../components/MovieCard.astro';
import EventDayGroup from '../components/EventDayGroup.astro';
import OccasionSpotlight from '../components/OccasionSpotlight.astro';
import Footer from '../components/Footer.astro';

// Load event data (from web_events.json or fallback to mock)
import { loadEventData } from '../data/loader';
import { groupEventsByDate, sliceEventGroups } from '../utils/groupEvents';
import {
  ALL_RADAR_CATEGORIES,
  getRadarCategoryOptions,
} from '../utils/radarCategoryFilter';
import { selectLandingOccasions } from '../utils/occasionSelection';

const eventData = loadEventData();
const { meta, movies, concerts, occasions } = eventData;
const visibleOccasions = selectLandingOccasions(occasions);

// Movies progressive disclosure: show first N days, hide the rest
const MOVIE_VISIBLE_DAYS = 3;
const visibleMovieDays = movies.slice(0, MOVIE_VISIBLE_DAYS);
const overflowMovieDays = movies.slice(MOVIE_VISIBLE_DAYS);
const hasMovieOverflow = overflowMovieDays.length > 0;

// Group events by date for timeline display
const eventGroups = groupEventsByDate(concerts);

// Smart progressive disclosure: complete day groups up to ~15 events
const VISIBLE_TARGET = 15;
const { visible: visibleGroups, overflow: overflowGroups } = sliceEventGroups(eventGroups, VISIBLE_TARGET);
const hasOverflow = overflowGroups.length > 0;

// Calculate overflow event count for button text
const overflowEventCount = overflowGroups.reduce((sum, g) => sum + g.events.length, 0);
const radarCategoryOptions = getRadarCategoryOptions(concerts);
const platzprojektCount = concerts.filter(
  event => event.sourceName === 'PLATZprojekt',
).length;
const hasPlatzprojektContext = (
  platzprojektCount > 0
  && platzprojektCount >= concerts.length * 0.25
);
---

<Base
  title="boringhannover - What's on in Hannover"
  description={`OV cinema listings, concerts and city events in Hannover for week ${meta.week}, ${meta.year}. Updated weekly, no ads, no cookies.`}
>
  <Header week={meta.week} year={meta.year} />

  {visibleOccasions.map((occasion, index) => (
    <OccasionSpotlight occasion={occasion} compact={index > 0} />
  ))}

  {occasions.length > visibleOccasions.length && (
    <div class="-mt-6 mb-10 text-center">
      <a
        href="/special/"
        class="inline-flex min-h-11 items-center font-display text-[11px] uppercase tracking-wide text-accent hover:underline"
        data-umami-event="occasion-index-open"
      >
        See all {occasions.length} City Occasions
      </a>
    </div>
  )}

  <!-- Movies Section -->
  <section class="mb-10">
    <SectionHeader title="Movies" />

    {visibleMovieDays.map((dayGroup) => (
      <div>
        <DateHeader day={dayGroup.day} date={dayGroup.date} />
        {dayGroup.movies.map((movie) => (
          <MovieCard
            title={movie.title}
            year={movie.year}
            time={movie.time}
            duration={movie.duration}
            language={movie.language}
            subtitles={movie.subtitles}
            rating={movie.rating}
            genre={movie.genre}
            url={movie.url}
          />
        ))}
      </div>
    ))}

    <!-- Movies overflow (hidden by default) -->
    {hasMovieOverflow && (
      <div id="movies-overflow" class="movies-overflow" aria-hidden="true">
        {overflowMovieDays.map((dayGroup, groupIndex) => (
          <div class="overflow-group" style={`--group-index: ${groupIndex}`}>
            <DateHeader day={dayGroup.day} date={dayGroup.date} />
            {dayGroup.movies.map((movie) => (
              <MovieCard
                title={movie.title}
                year={movie.year}
                time={movie.time}
                duration={movie.duration}
                language={movie.language}
                subtitles={movie.subtitles}
                rating={movie.rating}
                genre={movie.genre}
                url={movie.url}
              />
            ))}
          </div>
        ))}
      </div>
    )}

    <!-- Movies toggle button -->
    {hasMovieOverflow && (
      <button
        id="movies-toggle"
        type="button"
        class="radar-toggle"
        aria-expanded="false"
        aria-controls="movies-overflow"
      >
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span>
          <span class="dot">■</span>
          <span class="dot">■</span>
        </span>
        <span class="toggle-text">+{overflowMovieDays.length} MORE DAYS</span>
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span>
          <span class="dot">■</span>
          <span class="dot">■</span>
        </span>
      </button>
    )}

    {movies.length === 0 && (
      <p class="text-text-muted text-sm py-4">No OV movies found.</p>
    )}
  </section>

  <!-- Events Section (Timeline) -->
  <section class="mb-10">
    <SectionHeader title="Events On The Radar" />

    {radarCategoryOptions.length > 0 && (
      <div
        class="radar-filter"
        role="group"
        aria-labelledby="radar-filter-label"
      >
        <span id="radar-filter-label" class="radar-filter__label">Browse by</span>
        <div class="radar-filter__options scrollbar-hide">
          <button
            type="button"
            class="radar-filter__button"
            data-radar-filter={ALL_RADAR_CATEGORIES}
            aria-pressed="true"
          >
            All <span>{concerts.length}</span>
          </button>
          {radarCategoryOptions.map(({ category, count }) => (
            <button
              type="button"
              class="radar-filter__button"
              data-radar-filter={category}
              aria-pressed="false"
            >
              {category} <span>{count}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    {hasPlatzprojektContext && (
      <details class="source-context">
        <summary>
          Why {platzprojektCount} PLATZprojekt listings?
        </summary>
        <div>
          <p>
            PLATZprojekt is a community-run experimental space in Linden—not a
            single venue. Its calendar includes workshops, open groups, sport,
            markets, food, parties and live music across the site.
          </p>
          <a
            href="https://platzprojekt.de/ueber-uns/"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="source-context-open"
            data-umami-event-source="platzprojekt"
          >
            About PLATZprojekt ↗
          </a>
        </div>
      </details>
    )}

    <!-- Visible event groups -->
    <div id="events-visible" class="events-timeline">
      {visibleGroups.map((group) => (
        <EventDayGroup
          day={group.day}
          dayNum={group.dayNum}
          month={group.month}
          year={group.year}
          events={group.events}
        />
      ))}
    </div>

    <!-- Overflow event groups (hidden by default) -->
    {hasOverflow && (
      <div id="events-overflow" class="events-timeline events-overflow" aria-hidden="true">
        {overflowGroups.map((group, groupIndex) => (
          <div class="overflow-group" style={`--group-index: ${groupIndex}`}>
            <EventDayGroup
              day={group.day}
              dayNum={group.dayNum}
              month={group.month}
              year={group.year}
              events={group.events}
            />
          </div>
        ))}
      </div>
    )}

    <!-- Toggle button -->
    {hasOverflow && (
      <button
        id="radar-toggle"
        type="button"
        class="radar-toggle"
        aria-expanded="false"
        aria-controls="events-overflow"
      >
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span>
          <span class="dot">■</span>
          <span class="dot">■</span>
        </span>
        <span class="toggle-text">+{overflowEventCount} MORE</span>
        <span class="toggle-dots" aria-hidden="true">
          <span class="dot">■</span>
          <span class="dot">■</span>
          <span class="dot">■</span>
        </span>
      </button>
    )}

    {concerts.length === 0 && (
      <p class="text-text-muted text-sm py-4">No upcoming events.</p>
    )}
    <p id="radar-filter-empty" class="text-text-muted text-sm py-4" hidden>
      No events match this category.
    </p>
  </section>

  <Footer updatedAt={meta.updatedAt} />

  <!-- Legal links (required by German law) -->
  <nav class="mt-5 font-display text-[10px] md:text-[8px] text-text-muted text-center" aria-label="Legal">
    <a href="/impressum/" class="inline-block py-2 hover:text-text-secondary transition-colors">Impressum</a>
    <span class="mx-2">&middot;</span>
    <a href="/datenschutz/" class="inline-block py-2 hover:text-text-secondary transition-colors">Datenschutz</a>
  </nav>
</Base>

<script>
  import {
    ALL_RADAR_CATEGORIES,
    matchesRadarCategory,
  } from '../utils/radarCategoryFilter';

  // Progressive disclosure (show more/less) for Movies + Events.
  function setupDisclosure(toggleId, overflowId, options = {}) {
    const toggle = document.getElementById(toggleId);
    const overflow = document.getElementById(overflowId);
    const toggleText = toggle?.querySelector('.toggle-text');

    // Progressive enhancement: if the DOM isn't as expected, avoid leaving a dead button.
    if (!toggle) return;
    if (!overflow || !toggleText) {
      toggle.setAttribute('hidden', '');
      if (overflow) {
        overflow.setAttribute('aria-hidden', 'true');
        overflow.classList.remove('is-visible', 'is-expanded', 'is-collapsing');
      }
      return;
    }

    const originalText = toggleText.textContent;
    const expandedText = options.expandedText ?? 'SHOW LESS';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      // Track expand/collapse
      if (typeof umami !== 'undefined') {
        const action = isExpanded ? 'collapse' : 'expand';
        const section = toggleId.includes('movies') ? 'movies' : 'events';
        umami.track(`${section}-${action}`);
      }

      isExpanded ? collapse() : expand();
    });

    function expand() {
      toggle.setAttribute('aria-expanded', 'true');
      overflow.setAttribute('aria-hidden', 'false');
      overflow.classList.add('is-visible');

      if (!prefersReducedMotion) {
        // Force reflow so animation reliably triggers.
        void overflow.offsetHeight;
      }
      overflow.classList.add('is-expanded');

      toggleText.textContent = expandedText;
    }

    function collapse() {
      toggle.setAttribute('aria-expanded', 'false');
      overflow.setAttribute('aria-hidden', 'true');
      toggleText.textContent = originalText;

      if (prefersReducedMotion) {
        overflow.classList.remove('is-expanded', 'is-visible');
        scrollToToggle();
        return;
      }

      overflow.classList.add('is-collapsing');
      overflow.classList.remove('is-expanded');

      overflow.addEventListener('animationend', function handler() {
        overflow.removeEventListener('animationend', handler);
        overflow.classList.remove('is-collapsing', 'is-visible');
        scrollToToggle();
      }, { once: true });
    }

    function scrollToToggle() {
      const toggleRect = toggle.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      if (toggleRect.top < 0 || toggleRect.bottom > viewportHeight) {
        toggle.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'center' });
      }
    }
  }

  setupDisclosure('movies-toggle', 'movies-overflow');
  setupDisclosure('radar-toggle', 'events-overflow');

  function setupRadarFilter() {
    const filterButtons = Array.from(
      document.querySelectorAll('[data-radar-filter]'),
    );
    const eventItems = Array.from(
      document.querySelectorAll('[data-event-item]'),
    );
    const eventGroups = Array.from(
      document.querySelectorAll('[data-event-group]'),
    );
    const overflow = document.getElementById('events-overflow');
    const toggle = document.getElementById('radar-toggle');
    const emptyState = document.getElementById('radar-filter-empty');

    if (filterButtons.length === 0 || eventItems.length === 0) return;

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return;

        const selectedCategory = (
          button.dataset.radarFilter ?? ALL_RADAR_CATEGORIES
        );
        let visibleEventCount = 0;

        for (const item of eventItems) {
          if (!(item instanceof HTMLElement)) continue;

          const isVisible = matchesRadarCategory(
            item.dataset.radarCategory || null,
            selectedCategory,
          );
          item.classList.toggle('radar-hidden', !isVisible);
          visibleEventCount += Number(isVisible);
        }

        for (const group of eventGroups) {
          if (!(group instanceof HTMLElement)) continue;

          const hasVisibleEvent = Boolean(
            group.querySelector('[data-event-item]:not(.radar-hidden)'),
          );
          group.classList.toggle('radar-hidden', !hasVisibleEvent);
          group
            .closest('.overflow-group')
            ?.classList.toggle('radar-hidden', !hasVisibleEvent);
        }

        const isFiltering = selectedCategory !== ALL_RADAR_CATEGORIES;
        if (overflow) {
          overflow.setAttribute(
            'aria-hidden',
            String(!isFiltering && toggle?.getAttribute('aria-expanded') !== 'true'),
          );
          overflow.classList.toggle(
            'is-visible',
            isFiltering || toggle?.getAttribute('aria-expanded') === 'true',
          );
          overflow.classList.toggle(
            'is-expanded',
            isFiltering || toggle?.getAttribute('aria-expanded') === 'true',
          );
          overflow.classList.remove('is-collapsing');
        }
        toggle?.toggleAttribute('hidden', isFiltering);

        for (const option of filterButtons) {
          option.setAttribute(
            'aria-pressed',
            String(
              option instanceof HTMLElement
              && option.dataset.radarFilter === selectedCategory
            ),
          );
        }
        emptyState?.toggleAttribute('hidden', visibleEventCount > 0);

        if (typeof umami !== 'undefined') {
          // results lets a filter that finds nothing be told apart from one that
          // works — a category with repeated zero-result hits is a content gap.
          umami.track('events-category-filter', {
            category: selectedCategory,
            results: visibleEventCount,
          });
        }
      });
    }
  }

  setupRadarFilter();
</script>
