---
import Base from '../../layouts/Base.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
---

<Base
  title="Hannover in your inbox - boringhannover"
  description="The good stuff from Hannover, once a week. OV cinema, live music and city goings-on. No ads, no tracking, unsubscribe anytime."
>
  <article class="max-w-2xl">
    <a
      href="/"
      class="inline-block mb-6 text-text-muted hover:text-accent text-sm font-display"
    >
      &larr; Back
    </a>

    <h1 class="text-2xl font-bold text-text-primary mb-4 font-display">
      Hannover in your inbox
    </h1>

    <p class="text-text-secondary leading-relaxed text-sm">
      Once a week we round up the bits of Hannover worth leaving the flat for
      &mdash; original-version films, live music and the city&rsquo;s bigger
      moments &mdash; and send them your way. No fuss, no clutter.
    </p>

    <ul class="mt-4 space-y-1.5 text-xs text-text-secondary leading-relaxed list-disc list-inside">
      <li>One short email a week, in English, with the same picks as the site.</li>
      <li>No ads, no tracking pixels &mdash; ever.</li>
      <li>Double opt-in: nothing arrives until you confirm your address.</li>
      <li>Leave any time with one click &mdash; no login, no hard feelings.</li>
    </ul>

    <div class="mt-8">
      <NewsletterSignup />
    </div>
  </article>
</Base>
