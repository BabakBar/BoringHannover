---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Confirm your subscription - boringhannover"
  description="Confirm your boringhannover weekly email subscription."
>
  <article class="max-w-2xl">
    <a
      href="/newsletter/"
      class="inline-block mb-6 text-text-muted hover:text-accent text-sm font-display"
    >
      &larr; Back
    </a>

    <h1 class="text-2xl font-bold text-text-primary mb-4 font-display">
      Check your inbox
    </h1>

    <p class="text-text-secondary leading-relaxed text-sm">
      A confirmation email is on its way. Click the link inside to activate your
      subscription. If it does not arrive within a few minutes, check your spam
      folder.
    </p>
  </article>
</Base>
