---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Almost there - boringhannover"
  description="Confirm your boringhannover weekly email subscription."
>
  <article class="max-w-2xl">
    <a
      href="/newsletter/"
      class="inline-block mb-6 text-text-muted hover:text-accent text-sm font-display"
    >
      &larr; Back
    </a>

    <h1 class="text-2xl font-bold text-text-primary mb-4 font-display">
      Almost there
    </h1>

    <p class="text-text-secondary leading-relaxed text-sm">
      We&rsquo;ve sent you a confirmation email. Click the link inside and
      you&rsquo;re in. Can&rsquo;t see it? Give your spam folder a quick peek.
    </p>
  </article>
</Base>
