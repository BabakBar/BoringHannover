---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Unsubscribe - boringhannover"
  description="How to unsubscribe from the boringhannover weekly email."
>
  <article class="max-w-2xl">
    <a
      href="/"
      class="inline-block mb-6 text-text-muted hover:text-accent text-sm font-display"
    >
      &larr; Back
    </a>

    <h1 class="text-2xl font-bold text-text-primary mb-4 font-display">
      Leaving the list?
    </h1>

    <p class="text-text-secondary leading-relaxed text-sm">
      Use the personal unsubscribe link at the bottom of any weekly email. It
      takes you directly to your subscription settings and works without an
      account. If you no longer have an email, contact{' '}
      <a href="mailto:kontakt@boringhannover.de" class="text-accent hover:underline">
        kontakt@boringhannover.de
      </a>.
    </p>
  </article>
</Base>
