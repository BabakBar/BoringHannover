---
import Base from '../../layouts/Base.astro';
---

<Base
  title="You're off the list - boringhannover"
  description="You have been unsubscribed from the boringhannover weekly email."
>
  <article class="max-w-2xl">
    <a
      href="/"
      class="inline-block mb-6 text-text-muted hover:text-accent text-sm font-display"
    >
      &larr; Back
    </a>

    <h1 class="text-2xl font-bold text-text-primary mb-4 font-display">
      You&rsquo;re off the list
    </h1>

    <p class="text-text-secondary leading-relaxed text-sm">
      No hard feelings &mdash; you&rsquo;ve been unsubscribed. If you ever miss
      the good stuff, you&rsquo;re welcome back any time on the{' '}
      <a href="/newsletter/" class="text-accent hover:underline">
        newsletter page
      </a>
      .
    </p>
  </article>
</Base>
